<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/"><channel><title>Latex on NaiNai</title><link>https://npujol.github.io/en/tags/latex/</link><description>Recent Posts in Latex on NaiNai</description><generator>Hugo 0.163.3</generator><language>en-GB</language><lastBuildDate>Tue, 14 Jul 2026 23:42:20 +0200</lastBuildDate><atom:link href="https://npujol.github.io/en/tags/latex/index.xml" rel="self" type="application/rss+xml"/><item><title>Tufte Features</title><link>https://npujol.github.io/en/post/tufte-features/</link><pubDate>Sat, 07 Feb 2026 00:00:00 +0000</pubDate><dc:creator>Nainai</dc:creator><guid>https://npujol.github.io/en/post/tufte-features/</guid><description>&lt;h2 id="tufte-style-features"&gt;Tufte-Style Features&lt;/h2&gt;
&lt;p&gt;hugo-brewm implements several features inspired by Edward Tufte&amp;rsquo;s typographic principles.&lt;/p&gt;
&lt;h3 id="margin-notes"&gt;Margin Notes&lt;/h3&gt;
&lt;p&gt;Use the &lt;code&gt;marginnote&lt;/code&gt; shortcode for margin notes:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-html" data-lang="html"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;input id="marginnote-0" class="marginpar-ctrl" type="checkbox" aria-label="Additional Notes" aria-controls="the-marginnote-0" hidden&gt;
&lt;label for="marginnote-0" class="has-counter" tabindex="0" aria-label="Additional Notes" aria-controls="the-marginnote-0"&gt;&lt;/label&gt;
&lt;span id="the-marginnote-0" class="marginpar " role="note"&gt;This note appears in the margin.&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="margin-par"&gt;Margin Par&lt;/h3&gt;
&lt;p&gt;Use the &lt;code&gt;marginpar&lt;/code&gt; shortcode for margin paragraphs:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-html" data-lang="html"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;input id="marginpar-1" class="marginpar-ctrl" type="checkbox" aria-label="Additional Notes" aria-controls="the-marginpar-1" hidden&gt;
&lt;label for="marginpar-1" tabindex="0" aria-label="Additional Notes" aria-controls="the-marginpar-1"&gt;&lt;/label&gt;
&lt;span id="the-marginpar-1" class="marginpar " role="note"&gt;This is a margin paragraph with more detailed content.&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="epigraphs"&gt;Epigraphs&lt;/h3&gt;
&lt;p&gt;Use the &lt;code&gt;epigraph&lt;/code&gt; shortcode for epigraphs:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-html" data-lang="html"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;
&lt;div role="doc-epigraph" class="epigraph"&gt;
 &lt;blockquote&gt;
 The best way to predict the future is to invent it.
— Alan Kay
 &lt;/blockquote&gt;
&lt;/div&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="theorem"&gt;Theorem&lt;/h3&gt;
&lt;p&gt;Use the &lt;code&gt;theorem&lt;/code&gt; shortcode for mathematical theorems:&lt;/p&gt;</description><content:encoded>&lt;h2 id="tufte-style-features"&gt;Tufte-Style Features&lt;/h2&gt;

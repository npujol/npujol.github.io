<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:content="http://purl.org/rss/1.0/modules/content/"><channel><title>Alt on NaiNai</title><link>https://npujol.github.io/en/tags/alt/</link><description>Recent Posts in Alt on NaiNai</description><generator>Hugo 0.163.3</generator><language>en-GB</language><lastBuildDate>Tue, 14 Jul 2026 23:42:20 +0200</lastBuildDate><atom:link href="https://npujol.github.io/en/tags/alt/index.xml" rel="self" type="application/rss+xml"/><item><title>Authoring Custom Taxonomy</title><link>https://npujol.github.io/en/post/authoring-custom-taxonomy/</link><pubDate>Fri, 22 Aug 2025 00:00:00 +0000</pubDate><dc:creator>Nainai</dc:creator><guid>https://npujol.github.io/en/post/authoring-custom-taxonomy/</guid><description>&lt;h2 id="custom-taxonomy"&gt;Custom Taxonomy&lt;/h2&gt;
&lt;p&gt;hugo-brewm supports custom taxonomies beyond the default tags and categories.&lt;/p&gt;
&lt;h3 id="defining-taxonomies"&gt;Defining Taxonomies&lt;/h3&gt;
&lt;p&gt;Add taxonomies to your &lt;code&gt;config.toml&lt;/code&gt;:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-toml" data-lang="toml"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="p"&gt;[&lt;/span&gt;&lt;span class="nx"&gt;taxonomies&lt;/span&gt;&lt;span class="p"&gt;]&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;series&lt;/span&gt; &lt;span class="p"&gt;=&lt;/span&gt; &lt;span class="s1"&gt;&amp;#39;series&amp;#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;stage&lt;/span&gt; &lt;span class="p"&gt;=&lt;/span&gt; &lt;span class="s1"&gt;&amp;#39;stage&amp;#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;author&lt;/span&gt; &lt;span class="p"&gt;=&lt;/span&gt; &lt;span class="s1"&gt;&amp;#39;author&amp;#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="using-taxonomies-in-content"&gt;Using Taxonomies in Content&lt;/h3&gt;
&lt;p&gt;Assign taxonomies in your frontmatter:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-toml" data-lang="toml"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;---&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;title&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt; &lt;span class="s2"&gt;&amp;#34;My Article&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;series&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt; &lt;span class="s2"&gt;&amp;#34;My Series Name&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;stage&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt; &lt;span class="s2"&gt;&amp;#34;evergreen&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;tags&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;-&lt;/span&gt; &lt;span class="nx"&gt;taxonomy&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;-&lt;/span&gt; &lt;span class="nx"&gt;alt&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;---&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="series-taxonomy"&gt;Series Taxonomy&lt;/h3&gt;
&lt;p&gt;Series group related articles together. Each article in a series shares the same &lt;code&gt;series&lt;/code&gt; value.&lt;/p&gt;
&lt;h3 id="stage-taxonomy"&gt;Stage Taxonomy&lt;/h3&gt;
&lt;p&gt;Stages indicate the lifecycle of content:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Seedling&lt;/strong&gt; 🌱 — New or recently created&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Budding&lt;/strong&gt; 🌿 — Growing and evolving&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Evergreen&lt;/strong&gt; 🌳 — Established and maintained&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 id="displaying-taxonomies"&gt;Displaying Taxonomies&lt;/h3&gt;
&lt;p&gt;Taxonomies are displayed on:&lt;/p&gt;</description><content:encoded>&lt;h2 id="custom-taxonomy"&gt;Custom Taxonomy&lt;/h2&gt;
&lt;p&gt;hugo-brewm supports custom taxonomies beyond the default tags and categories.&lt;/p&gt;
&lt;h3 id="defining-taxonomies"&gt;Defining Taxonomies&lt;/h3&gt;
&lt;p&gt;Add taxonomies to your &lt;code&gt;config.toml&lt;/code&gt;:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-toml" data-lang="toml"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="p"&gt;[&lt;/span&gt;&lt;span class="nx"&gt;taxonomies&lt;/span&gt;&lt;span class="p"&gt;]&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;series&lt;/span&gt; &lt;span class="p"&gt;=&lt;/span&gt; &lt;span class="s1"&gt;&amp;#39;series&amp;#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;stage&lt;/span&gt; &lt;span class="p"&gt;=&lt;/span&gt; &lt;span class="s1"&gt;&amp;#39;stage&amp;#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;author&lt;/span&gt; &lt;span class="p"&gt;=&lt;/span&gt; &lt;span class="s1"&gt;&amp;#39;author&amp;#39;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="using-taxonomies-in-content"&gt;Using Taxonomies in Content&lt;/h3&gt;
&lt;p&gt;Assign taxonomies in your frontmatter:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-toml" data-lang="toml"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;---&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;title&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt; &lt;span class="s2"&gt;&amp;#34;My Article&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;series&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt; &lt;span class="s2"&gt;&amp;#34;My Series Name&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;stage&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt; &lt;span class="s2"&gt;&amp;#34;evergreen&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;tags&lt;/span&gt;&lt;span class="err"&gt;:&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;-&lt;/span&gt; &lt;span class="nx"&gt;taxonomy&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;-&lt;/span&gt; &lt;span class="nx"&gt;alt&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="nx"&gt;---&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h3 id="series-taxonomy"&gt;Series Taxonomy&lt;/h3&gt;
&lt;p&gt;Series group related articles together. Each article in a series shares the same &lt;code&gt;series&lt;/code&gt; value.&lt;/p&gt;
&lt;h3 id="stage-taxonomy"&gt;Stage Taxonomy&lt;/h3&gt;
&lt;p&gt;Stages indicate the lifecycle of content:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;&lt;strong&gt;Seedling&lt;/strong&gt; 🌱 — New or recently created&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Budding&lt;/strong&gt; 🌿 — Growing and evolving&lt;/li&gt;
&lt;li&gt;&lt;strong&gt;Evergreen&lt;/strong&gt; 🌳 — Established and maintained&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 id="displaying-taxonomies"&gt;Displaying Taxonomies&lt;/h3&gt;
&lt;p&gt;Taxonomies are displayed on:&lt;/p&gt;
&lt;ul&gt;
&lt;li&gt;Article pages (in the header and footer)&lt;/li&gt;
&lt;li&gt;Listing pages (grouped by taxonomy)&lt;/li&gt;
&lt;li&gt;Home page (if featuredListing is configured)&lt;/li&gt;
&lt;/ul&gt;
&lt;h3 id="featured-listing"&gt;Featured Listing&lt;/h3&gt;
&lt;p&gt;Configure which taxonomies appear on the home page:&lt;/p&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" class="chroma"&gt;&lt;code class="language-toml" data-lang="toml"&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt;&lt;span class="p"&gt;[&lt;/span&gt;&lt;span class="nx"&gt;params&lt;/span&gt;&lt;span class="p"&gt;.&lt;/span&gt;&lt;span class="nx"&gt;home&lt;/span&gt;&lt;span class="p"&gt;]&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span class="line"&gt;&lt;span class="cl"&gt; &lt;span class="nx"&gt;featuredListing&lt;/span&gt; &lt;span class="p"&gt;=&lt;/span&gt; &lt;span class="p"&gt;[&lt;/span&gt;&lt;span class="s1"&gt;&amp;#39;categories&amp;#39;&lt;/span&gt;&lt;span class="p"&gt;,&lt;/span&gt; &lt;span class="s1"&gt;&amp;#39;series&amp;#39;&lt;/span&gt;&lt;span class="p"&gt;]&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;</content:encoded><category>Authoring</category></item></channel></rss>